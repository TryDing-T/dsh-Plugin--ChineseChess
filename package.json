{
  "name": "@deepseek-ai/dsh-plugin-xiangqi",
  "version": "0.1.19",
  "description": "DSH 中国象棋对弈插件：侧边栏棋盘、Host 规则校验与 DSH 自动落子",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "lib/*.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.map",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-lib.mjs",
    "typecheck": "tsc -b tsconfig.host.json --pretty false && npm run generate:typert && tsc -b tsconfig.client.json --pretty false",
    "generate:typert": "node scripts/generate-typert.mjs",
    "check:typert": "node scripts/generate-typert.mjs --check",
    "build:host": "npm run clean && tsc -b tsconfig.host.json && npm run generate:typert && tsdown --env.DSH_BUILD_FACE host",
    "build:client": "tsc -b tsconfig.client.json && tsdown --env.DSH_BUILD_FACE client",
    "build": "npm run build:host && npm run build:client",
    "test": "npm run build && vitest run tests",
    "prepack": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.1",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-util-values": "0.1.5-alpha.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-typert-generator": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-util-values": "0.1.5-alpha.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "jsdom": "^26.0.0",
    "lightningcss": "^1.29.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
