{
  "//": "0.1.5 适配：类型全部从 node_modules 的 npm 包（0.1.5-alpha.1）解析，与运行时装配一致。",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "./.tsbuildinfo.host",
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/types.ts",
    "src/domain.ts",
    "src/game",
    "src/host"
  ],
  "exclude": ["src/client"]
}